{
    "name": "keil-assistant",
    "displayName": "%keil-assistant.displayName%",
    "description": "%keil-assistant.description%",
    "version": "1.7.0",
    "publisher": "x-leehe",
    "author": {
        "name": "x-leehe",
        "email": "x-leehe@outlook.com"
    },
    "keywords": [
        "keil",
        "mdk",
        "c51",
        "8051",
        "stm32"
    ],
    "homepage": "https://github.com/x-leehe/keil-VS-Code",
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "activationEvents": [
        "workspaceContains:**/*.uvprojx",
        "workspaceContains:**/*.uvproj"
    ],
    "icon": "res/icons/icon.png",
    "main": "./dist/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/x-leehe/keil-VS-Code.git"
    },
    "bugs": {
        "url": "https://github.com/x-leehe/keil-VS-Code/issues",
        "email": "2584456014@qq.com"
    },
    "contributes": {
        "configuration": [
            {
                "title": "%config.title%",
                "properties": {
                    "KeilAssistant.C51.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%KeilAssistant.C51.Uv4Path.markdownDescription%",
                        "default": "null"
                    },
                    "KeilAssistant.MDK.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%KeilAssistant.MDK.Uv4Path.markdownDescription%",
                        "default": "null"
                    },
                    "KeilAssistant.Project.ExcludeList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "%KeilAssistant.Project.ExcludeList.markdownDescription%",
                        "default": [
                            "template.uvproj",
                            "template.uvprojx"
                        ]
                    },
                    "KeilAssistant.Project.FileLocationList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "%KeilAssistant.Project.FileLocationList.markdownDescription%",
                        "default": []
                    },
                    "KeilAssistant.PackAndGo.Author": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "%KeilAssistant.PackAndGo.Author.markdownDescription%",
                        "default": ""
                    },
                    "KeilAssistant.PackAndGo.NamePattern": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "%KeilAssistant.PackAndGo.NamePattern.markdownDescription%",
                        "default": "${project}_${date}_${time}"
                    },
                    "KeilAssistant.PackAndGo.TemplatePath": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "%KeilAssistant.PackAndGo.TemplatePath.markdownDescription%",
                        "default": ""
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "project.newFromTemplate",
                "title": "%cmd.project.newFromTemplate.title%",
                "icon": "$(new-file)"
            },
            {
                "command": "explorer.open",
                "title": "%cmd.explorer.open.title%",
                "icon": "$(folder-opened)"
            },
            {
                "command": "project.switch",
                "title": "%cmd.project.switch.title%",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "project.active",
                "title": "%cmd.project.active.title%"
            },
            {
                "command": "project.close",
                "title": "%cmd.project.close.title%",
                "icon": "$(close)"
            },
            {
                "command": "project.build",
                "title": "%cmd.project.build.title%",
                "icon": "$(check-all)"
            },
            {
                "command": "project.rebuild",
                "title": "%cmd.project.rebuild.title%",
                "icon": "$(check)"
            },
            {
                "command": "project.download",
                "title": "%cmd.project.download.title%",
                "icon": "$(download)"
            },
            {
                "command": "item.copyValue",
                "title": "%cmd.item.copyValue.title%",
                "icon": "$(copy)"
            },
            {
                "command": "project.addFile",
                "title": "%cmd.project.addFile.title%",
                "icon": "$(file-add)"
            },
            {
                "command": "project.addFile.c",
                "title": "%cmd.project.addFile.c.title%",
                "icon": "$(file-code)"
            },
            {
                "command": "project.addFile.cpp",
                "title": "%cmd.project.addFile.cpp.title%",
                "icon": "$(file-code)"
            },
            {
                "command": "project.addFile.asm",
                "title": "%cmd.project.addFile.asm.title%",
                "icon": "$(file-binary)"
            },
            {
                "command": "project.addFile.asmPreprocess",
                "title": "%cmd.project.addFile.asmPreprocess.title%",
                "icon": "$(file-binary)"
            },
            {
                "command": "project.addFile.header",
                "title": "%cmd.project.addFile.header.title%",
                "icon": "$(symbol-key)"
            },
            {
                "command": "project.addFile.text",
                "title": "%cmd.project.addFile.text.title%",
                "icon": "$(file-text)"
            },
            {
                "command": "project.addFile.other",
                "title": "%cmd.project.addFile.other.title%",
                "icon": "$(file-add)"
            },
            {
                "command": "project.addFile.folder",
                "title": "%cmd.project.addFile.folder.title%",
                "icon": "$(folder)"
            },
            {
                "command": "project.importFile",
                "title": "%cmd.project.importFile.title%",
                "icon": "$(folder-opened)"
            },
            {
                "command": "project.toggleHeaderDeps",
                "title": "%cmd.project.toggleHeaderDeps.title%"
            },
            {
                "command": "project.showHeaderDeps",
                "title": "%cmd.project.showHeaderDeps.title%",
                "icon": "$(eye)"
            },
            {
                "command": "project.hideHeaderDeps",
                "title": "%cmd.project.hideHeaderDeps.title%",
                "icon": "$(eye-closed)"
            },
            {
                "command": "project.deleteFile",
                "title": "%cmd.project.deleteFile.title%",
                "icon": "$(trash)"
            },
            {
                "command": "project.packAndGo",
                "title": "%cmd.project.packAndGo.title%",
                "icon": "$(file-zip)"
            },
            {
                "command": "functionTreeView.refresh",
                "title": "%cmd.functionTreeView.refresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "functionTreeView.goto",
                "title": "%cmd.functionTreeView.goto.title%"
            },
            {
                "command": "functionTreeView.search",
                "title": "%cmd.functionTreeView.search.title%",
                "icon": "$(search)"
            },
            {
                "command": "project.toggleFileHeaderDeps",
                "title": "%cmd.project.toggleFileHeaderDeps.title%"
            },
            {
                "command": "project.toggleGroupHeaderDeps",
                "title": "%cmd.project.toggleGroupHeaderDeps.title%"
            },
            {
                "command": "keilSettings.edit",
                "title": "%cmd.keilSettings.edit.title%",
                "icon": "$(edit)"
            },
            {
                "command": "keilSettings.refresh",
                "title": "%cmd.keilSettings.refresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "keilSettings.switchTarget",
                "title": "%cmd.keilSettings.switchTarget.title%",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "keilSettings.loadFromProject",
                "title": "%cmd.keilSettings.loadFromProject.title%",
                "icon": "$(cloud-download)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "project.newFromTemplate",
                    "group": "navigation@1",
                    "when": "view == project"
                },
                {
                    "command": "explorer.open",
                    "group": "navigation@2",
                    "when": "view == project"
                },
                {
                    "command": "project.packAndGo",
                    "group": "navigation@3",
                    "when": "view == project"
                },
                {
                    "command": "project.switch",
                    "group": "navigation@4",
                    "when": "view == project"
                },
                {
                    "command": "keilSettings.loadFromProject",
                    "group": "navigation",
                    "when": "view == keilSettings"
                },
                {
                    "command": "keilSettings.switchTarget",
                    "group": "navigation",
                    "when": "view == keilSettings"
                },
                {
                    "command": "keilSettings.refresh",
                    "group": "navigation",
                    "when": "view == keilSettings"
                },
                {
                    "command": "functionTreeView.search",
                    "group": "navigation",
                    "when": "view == functionTreeView"
                },
                {
                    "command": "functionTreeView.refresh",
                    "group": "navigation",
                    "when": "view == functionTreeView"
                }
            ],
            "view/item/context": [
                {
                    "command": "project.build",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.build",
                    "group": "1_build@1",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "1_build@2",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "1_build@3",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.showHeaderDeps",
                    "group": "2_view",
                    "when": "viewItem == Target && !keilShowHeaderDeps"
                },
                {
                    "command": "project.hideHeaderDeps",
                    "group": "2_view",
                    "when": "viewItem == Target && keilShowHeaderDeps"
                },
                {
                    "submenu": "keilAddFile",
                    "group": "3_add@1",
                    "when": "viewItem == FileGroup || viewItem == Target"
                },
                {
                    "command": "project.importFile",
                    "group": "3_add@2",
                    "when": "viewItem == FileGroup || viewItem == Target"
                },
                {
                    "command": "project.build",
                    "group": "4_build@1",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.rebuild",
                    "group": "4_build@2",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.toggleGroupHeaderDeps",
                    "group": "5_view",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "item.copyValue",
                    "group": "inline",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.build",
                    "group": "2_build@1",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.rebuild",
                    "group": "2_build@2",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.deleteFile",
                    "group": "2_build@3",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.toggleFileHeaderDeps",
                    "group": "3_view",
                    "when": "viewItem == Source"
                },
                {
                    "command": "keilSettings.edit",
                    "when": "viewItem == keilSetting"
                }
            ],
            "keilAddFile": [
                {
                    "command": "project.addFile.c",
                    "group": "1_c"
                },
                {
                    "command": "project.addFile.cpp",
                    "group": "2_cpp"
                },
                {
                    "command": "project.addFile.asm",
                    "group": "3_asm"
                },
                {
                    "command": "project.addFile.asmPreprocess",
                    "group": "4_asmPre"
                },
                {
                    "command": "project.addFile.header",
                    "group": "5_header"
                },
                {
                    "command": "project.addFile.text",
                    "group": "6_text"
                },
                {
                    "command": "project.addFile.other",
                    "group": "7_other"
                },
                {
                    "command": "project.addFile.folder",
                    "group": "8_folder"
                }
            ]
        },
        "submenus": [
            {
                "id": "keilAddFile",
                "label": "%submenu.keilAddFile.label%"
            }
        ],
        "keybindings": [
            {
                "command": "project.build",
                "key": "f7"
            },
            {
                "command": "project.rebuild",
                "key": "ctrl+alt+f7"
            },
            {
                "command": "project.download",
                "key": "ctrl+alt+d"
            }
        ],
        "snippets": [
            {
                "language": "a51",
                "path": "./syntaxes/a51.snippets.json"
            }
        ],
        "languages": [
            {
                "id": "a51",
                "aliases": [
                    "A51",
                    "8051 Assembly"
                ],
                "extensions": [
                    ".a51",
                    ".A51"
                ],
                "filenamePatterns": [
                    "**/*.a51",
                    "**/*.A51"
                ],
                "configuration": "./syntaxes/a51.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "a51",
                "scopeName": "source.asm.a51",
                "path": "./syntaxes/a51.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "project",
                    "name": "%view.project.name%",
                    "icon": "$(folder)",
                    "when": "keilAssistant.hasProject"
                },
                {
                    "id": "functionTreeView",
                    "name": "%view.functionTreeView.name%",
                    "icon": "$(list-tree)",
                    "when": "keilAssistant.hasProject"
                },
                {
                    "id": "keilSettings",
                    "name": "%view.keilSettings.name%",
                    "icon": "$(settings)",
                    "when": "keilAssistant.hasProject"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "keil-task"
            }
        ],
        "problemMatchers": [
            {
                "name": "c51",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "armcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "gcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "webpack --mode production",
        "webpack": "webpack --mode development",
        "lint": "eslint src --ext .ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.93.0",
        "@types/xml2js": "^0.4.14",
        "@vscode/test-electron": "^2.5.0",
        "eslint": "^9.39.0",
        "typescript-eslint": "^8.48.0",
        "mocha": "^11.0.0",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "webpack": "^5.105.3",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^7.0.0",
        "adm-zip": "^0.5.17",
        "archiver": "^8.0.0",
        "vscode-variables": "^0.1.3",
        "xml2js": "^0.4.23"
    }
}
