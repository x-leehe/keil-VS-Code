{
    "name": "keil-assistant",
    "displayName": "keil VS Code",
    "description": "Keil 大战代码 — An assistant for Keil uVision",
    "version": "1.7.0",
    "publisher": "cl",
    "author": {
        "name": "cl",
        "email": "2584456014@qq.com"
    },
    "keywords": [
        "keil",
        "mdk",
        "c51",
        "8051",
        "stm32"
    ],
    "homepage": "https://github.com/x-leehe/keil-VS-Code",
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "activationEvents": [
        "workspaceContains:**/*.uvprojx",
        "workspaceContains:**/*.uvproj"
    ],
    "icon": "res/icons/icon.png",
    "main": "./dist/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/x-leehe/keil-VS-Code.git"
    },
    "bugs": {
        "url": "https://github.com/x-leehe/keil-VS-Code/issues",
        "email": "2584456014@qq.com"
    },
    "contributes": {
        "configuration": [
            {
                "title": "keil VS Code",
                "properties": {
                    "KeilAssistant.C51.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "C51 UV4.exe path",
                        "default": "null"
                    },
                    "KeilAssistant.MDK.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "MDK UV4.exe path",
                        "default": "null"
                    },
                    "KeilAssistant.Project.ExcludeList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "uVision project file name exclude list",
                        "default": [
                            "template.uvproj",
                            "template.uvprojx"
                        ]
                    },
                    "KeilAssistant.Project.FileLocationList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "uVision project file locations",
                        "default": []
                    },
                    "KeilAssistant.PackAndGo.Author": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "Name used for the `${author}` expression in Pack and Go filenames",
                        "default": ""
                    },
                    "KeilAssistant.PackAndGo.NamePattern": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "Default name pattern for Pack and Go. Supported expressions: `${project}`, `${date}`, `${time}`, `${author}`, `${target}`",
                        "default": "${project}_${date}_${time}"
                    },
                    "KeilAssistant.PackAndGo.TemplatePath": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "Custom path for storing Pack and Go templates. Leave empty to use `~/Documents/.KeilTemplates`",
                        "default": ""
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "explorer.open",
                "title": "打开 Keil 项目",
                "icon": "$(folder-opened)"
            },
            {
                "command": "project.switch",
                "title": "切换 Target",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "project.active",
                "title": "激活项目"
            },
            {
                "command": "project.close",
                "title": "关闭项目",
                "icon": "$(close)"
            },
            {
                "command": "project.build",
                "title": "全量编译",
                "icon": "$(check-all)"
            },
            {
                "command": "project.rebuild",
                "title": "增量编译",
                "icon": "$(check)"
            },
            {
                "command": "project.download",
                "title": "烧录到设备",
                "icon": "$(download)"
            },
            {
                "command": "item.copyValue",
                "title": "复制路径",
                "icon": "$(copy)"
            },
            {
                "command": "project.addFile",
                "title": "添加文件",
                "icon": "$(file-add)"
            },
            {
                "command": "project.addFile.c",
                "title": "C 语言文件(.c)",
                "icon": "$(file-code)"
            },
            {
                "command": "project.addFile.cpp",
                "title": "C++ 语言文件(.cpp)",
                "icon": "$(file-code)"
            },
            {
                "command": "project.addFile.asm",
                "title": "汇编文件(.s)",
                "icon": "$(file-binary)"
            },
            {
                "command": "project.addFile.asmPreprocess",
                "title": "C语言预处理汇编文件(.S)",
                "icon": "$(file-binary)"
            },
            {
                "command": "project.addFile.header",
                "title": "C/C++ 头文件(.h)",
                "icon": "$(symbol-key)"
            },
            {
                "command": "project.addFile.text",
                "title": "文本文件(.txt)",
                "icon": "$(file-text)"
            },
            {
                "command": "project.addFile.other",
                "title": "其他(.*)",
                "icon": "$(file-add)"
            },
            {
                "command": "project.importFile",
                "title": "导入文件…",
                "icon": "$(folder-opened)"
            },
            {
                "command": "project.toggleHeaderDeps",
                "title": "切换头文件依赖关系"
            },
            {
                "command": "project.showHeaderDeps",
                "title": "显示 头文件依赖关系",
                "icon": "$(eye)"
            },
            {
                "command": "project.hideHeaderDeps",
                "title": "隐藏 头文件依赖关系",
                "icon": "$(eye-closed)"
            },
            {
                "command": "project.deleteFile",
                "title": "删除文件",
                "icon": "$(trash)"
            },
            {
                "command": "project.packAndGo",
                "title": "Pack and Go",
                "icon": "$(file-zip)"
            },
            {
                "command": "functionTreeView.refresh",
                "title": "刷新函数列表",
                "icon": "$(refresh)"
            },
            {
                "command": "functionTreeView.goto",
                "title": "跳转到定义"
            },
            {
                "command": "functionTreeView.search",
                "title": "搜索函数…",
                "icon": "$(search)"
            },
            {
                "command": "project.toggleFileHeaderDeps",
                "title": "切换 依赖关系显示"
            },
            {
                "command": "project.toggleGroupHeaderDeps",
                "title": "切换 依赖关系显示"
            },
            {
                "command": "keilSettings.edit",
                "title": "Edit Keil Setting",
                "icon": "$(edit)"
            },
            {
                "command": "keilSettings.refresh",
                "title": "Refresh Keil Settings",
                "icon": "$(refresh)"
            },
            {
                "command": "keilSettings.switchTarget",
                "title": "Switch Target",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "keilSettings.loadFromProject",
                "title": "Load From Active Project",
                "icon": "$(cloud-download)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "explorer.open",
                    "group": "navigation",
                    "when": "view == project"
                },
                {
                    "command": "keilSettings.loadFromProject",
                    "group": "navigation",
                    "when": "view == keilSettings"
                },
                {
                    "command": "keilSettings.switchTarget",
                    "group": "navigation",
                    "when": "view == keilSettings"
                },
                {
                    "command": "keilSettings.refresh",
                    "group": "navigation",
                    "when": "view == keilSettings"
                },
                {
                    "command": "functionTreeView.search",
                    "group": "navigation",
                    "when": "view == functionTreeView"
                },
                {
                    "command": "functionTreeView.refresh",
                    "group": "navigation",
                    "when": "view == functionTreeView"
                }
            ],
            "view/item/context": [
                {
                    "command": "project.switch",
                    "group": "inline",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.active",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.close",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.packAndGo",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.build",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.build",
                    "group": "1_build@1",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "1_build@2",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "1_build@3",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.showHeaderDeps",
                    "group": "2_view",
                    "when": "viewItem == Target && !keilShowHeaderDeps"
                },
                {
                    "command": "project.hideHeaderDeps",
                    "group": "2_view",
                    "when": "viewItem == Target && keilShowHeaderDeps"
                },
                {
                    "submenu": "keilAddFile",
                    "group": "3_add@1",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.importFile",
                    "group": "3_add@2",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.build",
                    "group": "4_build@1",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.rebuild",
                    "group": "4_build@2",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.toggleGroupHeaderDeps",
                    "group": "5_view",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "item.copyValue",
                    "group": "inline",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.build",
                    "group": "2_build@1",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.rebuild",
                    "group": "2_build@2",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.deleteFile",
                    "group": "2_build@3",
                    "when": "viewItem == Source"
                },
                {
                    "command": "project.toggleFileHeaderDeps",
                    "group": "3_view",
                    "when": "viewItem == Source"
                },
                {
                    "command": "keilSettings.edit",
                    "when": "viewItem == keilSetting"
                }
            ],
            "keilAddFile": [
                {
                    "command": "project.addFile.c",
                    "group": "1_c"
                },
                {
                    "command": "project.addFile.cpp",
                    "group": "2_cpp"
                },
                {
                    "command": "project.addFile.asm",
                    "group": "3_asm"
                },
                {
                    "command": "project.addFile.asmPreprocess",
                    "group": "4_asmPre"
                },
                {
                    "command": "project.addFile.header",
                    "group": "5_header"
                },
                {
                    "command": "project.addFile.text",
                    "group": "6_text"
                },
                {
                    "command": "project.addFile.other",
                    "group": "7_other"
                }
            ]
        },
        "submenus": [
            {
                "id": "keilAddFile",
                "label": "添加…"
            }
        ],
        "keybindings": [
            {
                "command": "project.build",
                "key": "f7"
            },
            {
                "command": "project.rebuild",
                "key": "ctrl+alt+f7"
            },
            {
                "command": "project.download",
                "key": "ctrl+alt+d"
            }
        ],
        "snippets": [
            {
                "language": "a51",
                "path": "./syntaxes/a51.snippets.json"
            }
        ],
        "languages": [
            {
                "id": "a51",
                "aliases": [
                    "A51",
                    "8051 Assembly"
                ],
                "extensions": [
                    ".a51",
                    ".A51"
                ],
                "filenamePatterns": [
                    "**/*.a51",
                    "**/*.A51"
                ],
                "configuration": "./syntaxes/a51.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "a51",
                "scopeName": "source.asm.a51",
                "path": "./syntaxes/a51.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "project",
                    "name": "Keil uVision Project",
                    "icon": "$(folder)"
                },
                {
                    "id": "functionTreeView",
                    "name": "函数列表",
                    "icon": "$(list-tree)"
                },
                {
                    "id": "keilSettings",
                    "name": "Keil 项目设置",
                    "icon": "$(settings)"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "keil-task"
            }
        ],
        "problemMatchers": [
            {
                "name": "c51",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "armcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "gcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "webpack --mode production",
        "webpack": "webpack --mode development",
        "lint": "eslint src --ext .ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.93.0",
        "@types/xml2js": "^0.4.14",
        "@vscode/test-electron": "^2.5.0",
        "eslint": "^9.39.0",
        "typescript-eslint": "^8.48.0",
        "mocha": "^11.0.0",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "webpack": "^5.105.3",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^7.0.0",
        "adm-zip": "^0.5.17",
        "archiver": "^8.0.0",
        "vscode-variables": "^0.1.3",
        "xml2js": "^0.4.23"
    }
}
